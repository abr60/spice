{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chat",
  "model": "ollama/qwen2.5-coder:3b-8k",
  "small_model": "ollama/qwen2.5-coder:3b",
  "env": {
    "VISION_API_URL": "http://127.0.0.1:11434/v1/chat/completions",
    "VISION_API_KEY": "ollama",
    "VISION_MODEL": "minicpm-v4.6:1b",
    "VISION_FALLBACK_URL": ""
  },
  "plugin": [
    "./plugin/vision-bridge.ts",
    "@tarquinen/opencode-dcp@latest",
    "opencode-simple-notify"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "qwen2.5-coder:3b"
        },
        "qwen2.5-coder:3b-8k": {
          "name": "qwen2.5-coder:3b-8k"
        },
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b"
        },
        "llama3.1:8b": {
          "name": "llama3.1:8b"
        },
        "minicpm-v4.6:1b": {
          "name": "minicpm-v4.6:1b"
        },
        "qwen2.5vl:3b": {
          "name": "qwen2.5vl:3b"
        },
        "qwen2.5vl:7b": {
          "name": "qwen2.5vl:7b"
        }
      }
    }
  },
  "agent": {
    "chat": {
      "mode": "primary",
      "model": "ollama/qwen2.5-coder:3b",
      "description": "Fast local chat without project tools",
      "prompt": "Answer greetings and simple questions directly. Do not inspect files, call tools, search directories, delegate work, or access the network. Only use information already present in the conversation.",
      "tools": {
        "*": false
      }
    },
    "plan": {
      "model": "ollama/qwen2.5-coder:3b-8k",
      "prompt": "Answer simple questions directly. Work only in the current project directory. Do not use question, todo, task, web, or delegation tools. Do not search parent or home directories. Use tools only when the user explicitly requests project work.",
      "permission": {
        "external_directory": {
          "/home/abr/Projects/*": "allow"
        }
      },
      "tools": {
        "question": false,
        "todowrite": false,
        "task": false,
        "webfetch": false
      }
    },
    "build": {
      "model": "ollama/qwen2.5-coder:3b-8k",
      "prompt": "Answer greetings and simple questions directly without tools. Work only in the current project directory. Never use question, todo, task, web, or delegation tools. Do not search parent or home directories. Use tools only when the user explicitly requests project work.",
      "permission": {
        "edit": {
          "/home/abr/Projects/*": "allow"
        },
        "external_directory": {
          "/home/abr/Projects/*": "allow"
        }
      },
      "tools": {
        "question": false,
        "todowrite": false,
        "task": false,
        "webfetch": false
      }
    },
    "quickfix": {
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "Answer simple questions directly without tools. Work only in the current project directory. Never use question, todo, task, web, or delegation tools.",
      "permission": {
        "edit": {
          "/home/abr/Projects/*": "allow"
        },
        "external_directory": {
          "/home/abr/Projects/*": "allow"
        }
      },
      "tools": {
        "question": false,
        "todowrite": false,
        "task": false,
        "webfetch": false
      }
    },
    "explore": {
      "model": "ollama/qwen2.5-coder:3b",
      "prompt": "Work only in the current project directory. Never use question, todo, task, web, or delegation tools.",
      "permission": {
        "external_directory": {
          "/home/abr/Projects/*": "allow"
        }
      },
      "tools": {
        "question": false,
        "todowrite": false,
        "task": false,
        "webfetch": false
      }
    },
    "vision": {
      "model": "opencode/mimo-v2.5-free"
    }
  }
}

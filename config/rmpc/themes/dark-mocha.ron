#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#121318",
    text_color: "#e2e2e9",
    header_background_color: "#121318",
    modal_background_color: "#1e1f25",
    modal_backdrop: true,

    preview_label_style: (fg: "#b0c6ff", modifiers: "Bold"),
    preview_metadata_group_style: (fg: "#b0c6ff", modifiers: "Bold"),

    highlighted_item_style: (fg: "#b0c6ff", bg: "#2f4578", modifiers: "Bold"),
    current_item_style: (fg: "#e0bbdd", bg: "#2f4578", modifiers: "Bold"),

    borders_style: (fg: "#44464f"),
    highlight_border_style: (fg: "#b0c6ff"),

    symbols: (
        song: " ",
        dir: " ",
        playlist: "󰲹 ",
        marker: "● ",
        ellipsis: "…",
        song_style: (fg: "#8f9099"),
        dir_style: (fg: "#b0c6ff"),
        playlist_style: (fg: "#e0bbdd"),
        marker_style: (fg: "#ff699d"),
        song_highlighted_style: (fg: "#e2e2e9"),
        dir_highlighted_style: (fg: "#b0c6ff"),
        playlist_highlighted_style: (fg: "#e0bbdd"),
        marker_highlighted_style: (fg: "#ff699d"),
        song_current_style: (fg: "#e0bbdd", modifiers: "Bold"),
        dir_current_style: (fg: "#b0c6ff", modifiers: "Bold"),
        playlist_current_style: (fg: "#e0bbdd", modifiers: "Bold"),
        marker_current_style: (fg: "#ff699d", modifiers: "Bold"),
    ),

    level_styles: (
        info:  (fg: "#b0c6ff", bg: "#121318"),
        warn:  (fg: "#839cdd", bg: "#121318"),
        error: (fg: "#ff699d", bg: "#121318"),
        debug: (fg: "#00b644", bg: "#121318"),
        trace: (fg: "#e0bbdd", bg: "#121318"),
    ),

    progress_bar: (
        symbols: ["█", "█", "█", " ", "▏"],
        track_style: (fg: "#44464f"),
        elapsed_style: (fg: "#b0c6ff"),
        thumb_style: (fg: "#b0c6ff"),
        use_track_when_empty: true,
    ),

    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#1e1f25"),
        ends_style: (fg: "#44464f"),
        thumb_style: (fg: "#44464f"),
    ),

    tab_bar: (
        active_style: (fg: "#121318", bg: "#b0c6ff", modifiers: "Bold"),
        inactive_style: (fg: "#8f9099"),
    ),

    lyrics: (
        timestamp: false
    ),

    cava: (
        bar_color: Gradient({
            0:   "#ff699d",
            40:  "#ea66f9",
            70:  "#839cdd",
            100: "#b0c6ff",
        }),
        bar_symbols: ['▁','▂','▃','▄','▅','▆','▇','█'],
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
    ),

    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],

    song_table_format: [
        (
            prop: (kind: Property(Artist), default: (kind: Text("Unknown"))),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), default: (kind: Text("Unknown"))),
            label_prop: (kind: Text("Title")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#8f9099"),
                default: (kind: Text("Unknown Album"), style: (fg: "#8f9099"))
            ),
            label_prop: (kind: Text("Album")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), default: (kind: Text("-"))),
            label_prop: (kind: Text("Len")),
            width: "15%",
            alignment: Right,
        ),
    ],

    layout: Split(
        direction: Vertical,
        panes: [
            // ── Header ───────────────────────────────────────────────────
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "30",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "30",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            // ── Tab bar ──────────────────────────────────────────────────
            (
                pane: Pane(Tabs),
                borders: "LEFT | RIGHT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            // ── Main content ─────────────────────────────────────────────
            (
                size: "100%",
                borders: "NONE",
                pane: Pane(TabContent)
            ),
            // ── Progress bar ─────────────────────────────────────────────
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "10",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | RIGHT | BOTTOM",
                            border_symbols: Rounded,
                            border_title: [
                                (kind: Text(" ")),
                                (kind: Property(Status(QueueLength()))),
                                (kind: Text(" songs / ")),
                                (kind: Property(Status(QueueTimeTotal()))),
                                (kind: Text(" total time ")),
                            ],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),

    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#44464f")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#b0c6ff", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#44464f")),
            ], align: Left,
        )),

        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#e2e2e9", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#44464f", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),

        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "9", pane: Pane(Property(content: [(kind: Text("Volume: "), style: (fg: "#8f9099"))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "4", pane: Pane(Property(content: [
                    (kind: Property(Status(Volume)), style: (fg: "#b0c6ff")),
                    (kind: Text("%"), style: (fg: "#8f9099")),
                ], align: Right))),
            ]
        ),

        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#b0c6ff")),
                (kind: Text(" / "), style: (fg: "#44464f")),
                (kind: Property(Status(Duration)), style: (fg: "#8f9099")),
                (kind: Group([
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ]), style: (fg: "#44464f")),
            ],
            align: Left,
        )),

        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#b0c6ff", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#b0c6ff", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "#44464f")),
                (kind: Property(Song(Album)), style: (fg: "#8f9099"),
                    default: (kind: Text("Unknown Album"), style: (fg: "#8f9099"))),
            ], align: Center, scroll_speed: 1
        )),

        "states": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "100%", pane: Pane(Property(content: [
                    (kind: Property(Status(InputBuffer())), style: (fg: "#b0c6ff"), align: Left)
                ]))),
                (size: "6", pane: Pane(Property(content: [
                    (kind: Text("["), style: (fg: "#44464f")),
                    (kind: Property(Status(RepeatV2(
                        on_label: "r",
                        off_label: "r",
                        on_style: (fg: "#b0c6ff", modifiers: "Bold"),
                        off_style: (fg: "#44464f"),
                    )))),
                    (kind: Property(Status(RandomV2(
                        on_label: "z",
                        off_label: "z",
                        on_style: (fg: "#b0c6ff", modifiers: "Bold"),
                        off_style: (fg: "#44464f"),
                    )))),
                    (kind: Property(Status(ConsumeV2(
                        on_label: "x",
                        off_label: "x",
                        oneshot_label: "x",
                        on_style: (fg: "#b0c6ff", modifiers: "Bold"),
                        off_style: (fg: "#44464f"),
                        oneshot_style: (fg: "#ff699d"),
                    )))),
                    (kind: Property(Status(SingleV2(
                        on_label: "c",
                        off_label: "c",
                        oneshot_label: "c",
                        on_style: (fg: "#b0c6ff", modifiers: "Bold"),
                        off_style: (fg: "#44464f"),
                        oneshot_style: (fg: "#ff699d", modifiers: "Bold"),
                    )))),
                    (kind: Text("]"), style: (fg: "#44464f")),
                ], align: Right))),
            ]
        ),

        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#121318", bg: "#b0c6ff"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#121318", bg: "#00b644"))),
                ])))
            ], align: Center
        )),

        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),

        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),

        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),

        "play_button": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(StateV2()))), replacements: [
                    (match: "Playing", replace: (kind: Text("▶"), style: (fg: "#b0c6ff"))),
                    (match: "Paused",  replace: (kind: Text("⏸"), style: (fg: "#8f9099"))),
                    (match: "Stopped", replace: (kind: Text("⏹"), style: (fg: "#44464f"))),
                ])))
            ], align: Center
        )),

        "time_display": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#8f9099")),
                (kind: Text(" / "), style: (fg: "#44464f")),
                (kind: Property(Status(Duration)), style: (fg: "#8f9099")),
            ], align: Right
        )),

        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "3%", pane: Component("play_button")),
                (size: "90%", pane: Pane(ProgressBar)),
                (borders: "LEFT", border_symbols: Rounded, size: "10%", pane: Component("time_display")),
            ]
        ),
    },
)

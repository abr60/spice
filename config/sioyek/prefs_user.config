# --- UI and Startup ---
startup_commands toggle_fullscreen;toggle_scrollbar
should_launch_new_window 1

# --- Status Bar Styling ---
status_bar_font_size 20
status_font "JetBrainsMono Nerd Font"
status_bar_padding 10
status_bar_color 0.157 0.157 0.157
status_bar_text_color 0.922 0.859 0.698
status_bar_format Page | %{current_page}/%{num_pages}

# --- Gruvbox Dark Theme ---
custom_background_color 0.157 0.157 0.157
custom_text_color 0.922 0.859 0.698

# Search highlight: Gruvbox Aqua
search_highlight_color 0.408 0.616 0.416

# Link labels: Gruvbox Orange
overview_f_background_color 0.827 0.478 0.400
overview_f_text_color 0.157 0.157 0.157

# Selection: Gruvbox bg3 (subtle, non-distracting)
visual_mark_color 0.322 0.302 0.275 0.5


# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000b01"

# Main text color
theme[main_fg]="#d2dcc3"

# Title color for boxes
theme[title]="#d2dcc3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#579789"

# Background color of selected item in processes box. #d2dcc3 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a231a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a231a"

# Foreground color of selected item in processes box. Use #d2dcc3 so
# the row text stays readable on the lighter_bg highlight; the previous
# #579789 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d2dcc3"

# Color of inactive/disabled text
theme[inactive_fg]="#5a5f5a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #d9e1cc caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d2dcc3 directly.
theme[graph_text]="#d2dcc3"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #d2dcc3 collapsed to the main fg.
theme[meter_bg]="#1a231a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #6aae9e for a distinct accent instead of #d9e1cc which capped to white.
theme[proc_misc]="#6aae9e"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#609d8f"
theme[mem_box]="#85a27f"
theme[net_box]="#6e8d6c"
theme[proc_box]="#579789"

# Box divider line and small boxes line color
theme[div_line]="#5a5f5a"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#85a27f"
theme[temp_mid]="#a3ae83"
theme[temp_end]="#6e8d6c"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#6aae9e"
theme[cpu_mid]="#579789"
theme[cpu_end]="#609d8f"

# Mem/Disk free meter
theme[free_start]="#609d8f"
theme[free_mid]="#579789"
theme[free_end]="#6aae9e"

# Mem/Disk cached meter
theme[cached_start]="#579789"
theme[cached_mid]="#6aae9e"
theme[cached_end]="#609d8f"

# Mem/Disk available meter
theme[available_start]="#a3ae83"
theme[available_mid]="#6e8d6c"
theme[available_end]="#6e8d6c"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#85a27f"
theme[used_mid]="#6aae9e"
theme[used_end]="#579789"

# Download graph colors
theme[download_start]="#a3ae83"
theme[download_mid]="#6e8d6c"
theme[download_end]="#6e8d6c"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#85a27f"
theme[upload_mid]="#6aae9e"
theme[upload_end]="#579789"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6aae9e"
theme[process_mid]="#579789"
theme[process_end]="#609d8f"

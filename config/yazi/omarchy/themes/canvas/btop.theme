# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0e0e05"

# Main text color
theme[main_fg]="#d6c3d8"

# Title color for boxes
theme[title]="#d6c3d8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9ca4bb"

# Background color of selected item in processes box. #d6c3d8 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #26261e gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#26261e"

# Foreground color of selected item in processes box. Use #d6c3d8 so
# the row text stays readable on the lighter_bg highlight; the previous
# #9ca4bb produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d6c3d8"

# Color of inactive/disabled text
theme[inactive_fg]="#666760"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #dcccde caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d6c3d8 directly.
theme[graph_text]="#d6c3d8"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #d6c3d8 collapsed to the main fg.
theme[meter_bg]="#26261e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #989f87 for a distinct accent instead of #dcccde which capped to white.
theme[proc_misc]="#989f87"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8e7c92"
theme[mem_box]="#787e65"
theme[net_box]="#857960"
theme[proc_box]="#9ca4bb"

# Box divider line and small boxes line color
theme[div_line]="#666760"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#787e65"
theme[temp_mid]="#939670"
theme[temp_end]="#857960"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#989f87"
theme[cpu_mid]="#bb9ca4"
theme[cpu_end]="#8e7c92"

# Mem/Disk free meter
theme[free_start]="#8e7c92"
theme[free_mid]="#bb9ca4"
theme[free_end]="#989f87"

# Mem/Disk cached meter
theme[cached_start]="#bb9ca4"
theme[cached_mid]="#989f87"
theme[cached_end]="#8e7c92"

# Mem/Disk available meter
theme[available_start]="#939670"
theme[available_mid]="#857960"
theme[available_end]="#857960"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#787e65"
theme[used_mid]="#989f87"
theme[used_end]="#bb9ca4"

# Download graph colors
theme[download_start]="#939670"
theme[download_mid]="#857960"
theme[download_end]="#857960"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#787e65"
theme[upload_mid]="#989f87"
theme[upload_end]="#bb9ca4"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#989f87"
theme[process_mid]="#bb9ca4"
theme[process_end]="#8e7c92"

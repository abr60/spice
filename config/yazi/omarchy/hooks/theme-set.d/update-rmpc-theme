#!/bin/bash

# Update rmpc theme when omarchy theme changes
THEME_DIR="$HOME/.local/state/omarchy/current/theme"
GENERATED_THEME="$THEME_DIR/omarchy.ron"
RMPC_CONFIG="$HOME/.config/rmpc"

# Ensure rmpc themes directory exists
mkdir -p "$RMPC_CONFIG/themes"

# Symlink the generated theme into rmpc's themes directory
if [[ -f "$GENERATED_THEME" ]]; then
    ln -sf "$GENERATED_THEME" "$RMPC_CONFIG/themes/omarchy.ron"
fi
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "stappmus.activity-monitor"
        },
        {
          "id": "ssupt.bluetooth-audio"
        },
        {
          "id": "omarchy.network"

#!/bin/bash

# Update yazi theme when omarchy theme changes
THEME_DIR="$HOME/.local/state/omarchy/current/theme"
TEMPLATE="$HOME/.config/omarchy/themed/yazi.toml.tpl"
YAZI_CONFIG="$HOME/.config/yazi"

# Ensure yazi config directory exists
mkdir -p "$YAZI_CONFIG"

# Generate yazi.toml from template if template exists
if [[ -f "$TEMPLATE" && -f "$THEME_DIR/colors.toml" ]]; then
    # Start with a copy of the template
    cp "$TEMPLATE" "$THEME_DIR/yazi.toml"

    # Use omarchy-theme-color for the full resolved color set (handles derived
    # aliases like dark_background, lighter_background, light_foreground that are
    # not present in the raw colors.toml). Output is tab-separated key/value.
    sed_script=$(mktemp)
    while IFS=$'\t' read -r key value; do
        [[ -n "$key" && -n "$value" ]] || continue
        printf 's|{{ %s }}|%s|g\n' "$key" "$value" >> "$sed_script"
    done < <(omarchy-theme-color --file "$THEME_DIR/colors.toml" --all 2>/dev/null)

    sed -i -f "$sed_script" "$THEME_DIR/yazi.toml"
    rm -f "$sed_script"
fi

# Symlink yazi theme to the generated theme file
if [[ -f "$THEME_DIR/yazi.toml" ]]; then
    ln -sf "$THEME_DIR/yazi.toml" "$YAZI_CONFIG/theme.toml"
fi

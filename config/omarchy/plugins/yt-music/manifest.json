{
  "schemaVersion": 1,
  "id": "yt-music",
  "name": "YT Music Window Control",
  "version": "0.1.3",
  "author": "ilyaZar",
  "license": "MIT",
  "description": "Adds a binding-scoped YouTube Music WebApp drop-down with configurable top-edge geometry and compact bar controls.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "YT Music Window Control",
    "description": "Toggle YouTube Music and set its alignment and size.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "alignment": "Center",
      "windowWidth": 450,
      "windowHeight": 800,
      "iconVisible": true
    },
    "schema": [
      {
        "key": "alignment",
        "type": "enum",
        "label": "Horizontal alignment",
        "options": [
          "Left",
          "Center",
          "Right"
        ],
        "defaultValue": "Left"
      },
      {
        "key": "windowWidth",
        "type": "integer",
        "label": "Window width",
        "min": 1,
        "max": 100000,
        "step": 50,
        "defaultValue": 450
      },
      {
        "key": "windowHeight",
        "type": "integer",
        "label": "Window height",
        "min": 1,
        "max": 100000,
        "step": 50,
        "defaultValue": 800
      },
      {
        "key": "iconVisible",
        "type": "boolean",
        "label": "Show bar icon",
        "defaultValue": true
      }
    ]
  }
}

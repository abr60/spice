#!/usr/bin/env bash
# Bluetooth notifier – minimal and effective

set -u

readonly LOW_BATTERY_THRESHOLD=20
readonly ICON_CONNECTED="bluetooth"
readonly ICON_DISCONNECTED="bluetooth-disabled"
readonly ICON_LOW_BATTERY="battery-low"
readonly POLL_INTERVAL=5  # Check every 5 seconds

LOG_FILE="/tmp/bluetooth_notifier.log"
echo "→ Bluetooth notifier started at $(date)" >> "$LOG_FILE"

get_first_connected_mac() {
    bluetoothctl devices Connected | awk 'NR==1 {print $2}'
}

get_device_name() {
    local mac="$1"
    bluetoothctl info "$mac" | awk -F': *' '/^\s*Name:/ {print $2; exit}'
}

get_battery_percentage() {
    local mac="$1"
    bluetoothctl info "$mac" | awk -F'[()]' '/Battery Percentage:/ {gsub(/[^0-9]/,"",$2); print $2; exit}'
}

notify_connection() {
    local mac="$1"
    local name batt
    name=$(get_device_name "$mac")
    [[ -z "$name" ]] && name="Bluetooth device"

    batt=$(get_battery_percentage "$mac")

    if [[ -n "$batt" ]]; then
        notify-send -i "$ICON_CONNECTED" "$name" "Battery: ${batt}%"
    else
        notify-send -i "$ICON_CONNECTED" "$name" "Connected"
    fi
}

notify_disconnection() {
    local mac="$1"
    local name
    name=$(get_device_name "$mac")
    [[ -z "$name" ]] && name="Bluetooth device"

    notify-send -i "$ICON_DISCONNECTED" "$name" "Disconnected"
}

echo "→ Bluetooth notifier running (polling every $POLL_INTERVAL seconds)"

last_connected_mac=""

while true; do
    current_connected_mac=$(get_first_connected_mac)

    if [[ -n "$current_connected_mac" && "$current_connected_mac" != "$last_connected_mac" ]]; then
        echo "→ New connection: $current_connected_mac at $(date)" >> "$LOG_FILE"
        notify_connection "$current_connected_mac"
    elif [[ -z "$current_connected_mac" && -n "$last_connected_mac" ]]; then
        echo "→ Disconnection: $last_connected_mac at $(date)" >> "$LOG_FILE"
        notify_disconnection "$last_connected_mac"
    fi

    last_connected_mac="$current_connected_mac"
    sleep "$POLL_INTERVAL"
done
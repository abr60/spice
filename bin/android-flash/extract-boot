#!/usr/bin/env bash
set -euo pipefail
# extract-boot — boot.img + unbrick, organized per-ROM folder

ZIP="${1:-}"

pick_zip() {
  mapfile -t zips < <(ls -1 *.zip 2>/dev/null | sort)
  (( ${#zips[@]} )) || { echo "No .zip in $(pwd)" >&2; exit 1; }
  if command -v fzf &>/dev/null; then
    printf '%s\n' "${zips[@]}" | fzf --prompt="ROM zip > " --height=15 --reverse
  else
    echo "Select ROM zip:"
    select z in "${zips[@]}"; do [[ -n "$z" ]] && echo "$z" && break; done
  fi
}
[[ -n "$ZIP" ]] || ZIP="$(pick_zip)"
[[ -f "$ZIP" ]] || { echo "Not found: $ZIP" >&2; exit 1; }

# --- dependency check ---
missing=()
need_msg=()
if ! command -v payload-dumper-go &>/dev/null; then
  missing+=("payload-dumper-go-bin")
  need_msg+=("  payload-dumper-go  →  yay -S payload-dumper-go-bin  (AUR)")
fi
if ! command -v unzip &>/dev/null; then
  missing+=("unzip")
  need_msg+=("  unzip            →  sudo pacman -S unzip")
fi
if ! command -v adb &>/dev/null || ! command -v fastboot &>/dev/null; then
  missing+=("android-tools")
  need_msg+=("  adb / fastboot   →  sudo pacman -S android-tools")
fi
if (( ${#missing[@]} )); then
  echo "Missing required tools:" >&2
  printf '%s\n' "${need_msg[@]}" >&2
  echo >&2
  read -rp "Install now? [y/N] " ans
  if [[ "$ans" =~ ^[yY] ]]; then
    for pkg in "${missing[@]}"; do
      if [[ "$pkg" == "payload-dumper-go-bin" ]]; then
        if command -v yay &>/dev/null; then yay -S --noconfirm "$pkg"
        elif command -v paru &>/dev/null; then paru -S --noconfirm "$pkg"
        else echo "No yay/paru — install $pkg manually" >&2; exit 1; fi
      else
        sudo pacman -S --noconfirm "$pkg"
      fi
    done
  else
    exit 1
  fi
fi

# --- extract ---
unzip -l "$ZIP" 2>/dev/null | grep -q "payload.bin" || { echo "No payload.bin in $ZIP" >&2; exit 1; }

BASE="$(basename "$ZIP" .zip)"
# crDroidAndroid-14.0-20240601-spes-v10.5 → crDroid-spes-v10.5
ROM_DIR="$(echo "$BASE" | sed -E 's/Android-[0-9.]+-[0-9]{8}-//')"
[[ -n "$ROM_DIR" ]] || ROM_DIR="$BASE"
# sanitize
ROM_DIR="${ROM_DIR//[^a-zA-Z0-9._-]/-}"

mkdir -p "$ROM_DIR/boot-img" "$ROM_DIR/unbrick"

echo "→ $ZIP → $ROM_DIR/"
payload-dumper-go -p boot -o "$ROM_DIR/boot-img" "$ZIP"

IMG="$ROM_DIR/boot-img/boot.img"
[[ -f "$IMG" ]] || { echo "Failed: $IMG not created" >&2; exit 1; }

ls -lh "$IMG"
sha256sum "$IMG"
cp -v "$IMG" "$ROM_DIR/unbrick/spes-stock-boot.img"
sha256sum "$ROM_DIR/unbrick/spes-stock-boot.img"

echo
echo "Done."
echo "  boot:    $ROM_DIR/boot-img/boot.img"
echo "  unbrick: $ROM_DIR/unbrick/spes-stock-boot.img  (fastboot flash boot_b $ROM_DIR/unbrick/spes-stock-boot.img)"
if command -v tree &>/dev/null; then tree "$ROM_DIR"
else find "$ROM_DIR" -type f -o -type d | sort; fi

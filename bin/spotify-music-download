#!/bin/bash
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$BIN_DIR/lib/helpers.sh"
clear

# ── Logo ────────────────────────────────────────────────────────────────────
cat "$BIN_DIR/../config/hypr/assets/branding/grabber.txt" 2>/dev/null || echo "Spotify Downloader"

# ── Info Box ────────────────────────────────────────────────────────────────
gum style --border rounded --border-foreground 6 --padding "1 2" \
  "" \
  "• Paste a Spotify track, album, or playlist URL" \
  "• Cover art & lyrics embedded into MP3" \
  "• Downloads to ~/Music/Spotify" \
  "" \
  "$(gum style --foreground 8 "Powered by spotifydl")"

echo

# ── URL Input ────────────────────────────────────────────────────────────────
clip_url=$(wl-paste 2>/dev/null || true)
[[ "$clip_url" != https://open.spotify.com* ]] && clip_url=""

url=$(gum input --prompt "URL: " --placeholder "Spotify track / album / playlist URL" --value "$clip_url")
[[ -z "$url" ]] && { log_info "Cancelled"; exit 0; }

if [[ "$url" != https://open.spotify.com/* ]]; then
  log_error "Not a valid Spotify URL"
  show_done; exit 1
fi

# ── Download ──────────────────────────────────────────────────────────────────
download_dir="$HOME/Music/Spotify"
mkdir -p "$download_dir"

# Snapshot files before download so we can find what's new
before_files=$(mktemp)
find "$HOME/Music" -maxdepth 1 -type f \( \
  -iname "*.mp3" -o -iname "*.flac" -o \
  -iname "*.opus" -o -iname "*.m4a" -o \
  -iname "*.ogg" \) -printf '%f\n' 2>/dev/null | sort > "$before_files"

# Also check CWD for spotifydl's fallback behavior
before_cwd=$(mktemp)
ls *.mp3 *.flac *.opus *.m4a *.ogg 2>/dev/null | sort > "$before_cwd" 2>/dev/null || true

echo
log_step "Downloading (embedded)..."
echo

dl_log=$(mktemp)
spotifydl embedded "$url" 2>"$dl_log"
status=$?

if [[ $status -ne 0 ]]; then
  log_info "spotifydl failed — waiting 5s before retry..."
  sleep 5
  rm -f "$dl_log"
  dl_log=$(mktemp)
  spotifydl embedded "$url" 2>"$dl_log"
  status=$?
fi

[[ -s "$dl_log" ]] && cat "$dl_log"

# ── Find and move new files ──────────────────────────────────────────────────
echo
log_step "Moving files to $download_dir..."

moved=0

# Check ~/Music for new files
if [[ -d "$HOME/Music" ]]; then
  find "$HOME/Music" -maxdepth 1 -type f \( \
    -iname "*.mp3" -o -iname "*.flac" -o \
    -iname "*.opus" -o -iname "*.m4a" -o \
    -iname "*.ogg" \) -printf '%f\n' 2>/dev/null | sort > "${before_files}.after"

  new_files=$(comm -13 "$before_files" "${before_files}.after")
  if [[ -n "$new_files" ]]; then
    while IFS= read -r f; do
      mv -v "$HOME/Music/$f" "$download_dir/" && (( moved++ ))
    done <<< "$new_files"
  fi
fi

# Check CWD for new files (spotifydl sometimes saves here)
if [[ -d "." ]]; then
  ls *.mp3 *.flac *.opus *.m4a *.ogg 2>/dev/null | sort > "${before_cwd}.after" 2>/dev/null || true
  new_cwd=$(comm -13 "$before_cwd" "${before_cwd}.after" 2>/dev/null)
  if [[ -n "$new_cwd" ]]; then
    while IFS= read -r f; do
      [[ -f "$f" ]] && mv -v "$f" "$download_dir/" && (( moved++ ))
    done <<< "$new_cwd"
  fi
fi

# ── Result ────────────────────────────────────────────────────────────────────
echo
if [[ $status -eq 0 ]]; then
  if [[ $moved -gt 0 ]]; then
    log_success "Saved $moved file(s) to $download_dir"
  else
    log_success "Download completed (no new files to move)"
  fi
else
  log_error "Download failed"
  [[ -s "$dl_log" ]] && {
    gum style --foreground 9 "  Errors:"
    cat "$dl_log" | sed 's/^/    /'
  }
fi

# ── MPD sync ──────────────────────────────────────────────────────────────────
echo
log_step "Updating MPD library..."
mpc update 2>/dev/null || log_info "MPD not running — skipping sync"

# ── Cleanup ───────────────────────────────────────────────────────────────────
rm -f "$before_files" "${before_files}.after" "$before_cwd" "${before_cwd}.after" "$dl_log"

# ── Auto-close ────────────────────────────────────────────────────────────────
echo
gum style --foreground 2 "  ✓ Done!"
echo
for i in $(seq 10 -1 1); do
  printf "\r  Closing in %d seconds... (press any key to close now)  " "$i"
  read -r -s -n1 -t1 key && break
done
echo

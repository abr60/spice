#!/usr/bin/env bash
# mpv-launch — GPU-aware MPV wrapper for Omarchy/Hyprland
# Location: ~/.config/hypr/scripts/Precious/mpv-launch
#
# Usage:
#   mpv-launch [file/URL ...]
#   MPV_DEBUG=1 mpv-launch [file/URL ...]   ← verbose GPU detection output

# ── Defaults (safe fallback for any machine) ──────────────────────────────────
HWDEC="auto"
VO="gpu-next"
GPU_API="auto"
GPU_LABEL="unknown"

# ── GPU Detection ─────────────────────────────────────────────────────────────
if command -v lspci &>/dev/null; then
    GPU_INFO=$(lspci -mm | grep -iE 'vga|3d|display' | head -1 | awk -F '"' '{print $4 $6}')

    if [[ $GPU_INFO =~ NVIDIA ]]; then
        HWDEC="vulkan"
        GPU_API="vulkan"
        VO="gpu-next"
        GPU_LABEL="NVIDIA → vulkan hwdec + vulkan api"

    elif [[ $GPU_INFO =~ AMD|ATI|Radeon ]]; then
        HWDEC="vulkan"
        GPU_API="vulkan"
        VO="gpu-next"
        GPU_LABEL="AMD/Radeon → vulkan hwdec + vulkan api"

    elif [[ $GPU_INFO =~ Intel ]]; then
        # Tiger Lake (11th gen) and newer: Vulkan is stable on Arch/Wayland.
        # VA-API is used for hardware decode (AV1, HEVC, H.264 all supported).
        HWDEC="vaapi"
        GPU_API="vulkan"
        VO="gpu-next"
        GPU_LABEL="Intel → vaapi hwdec + vulkan api"

        # Sanity-check: fall back if vaapi isn't actually working
        if command -v vainfo &>/dev/null; then
            if ! vainfo 2>/dev/null | grep -q -i "VAProfile"; then
                HWDEC="auto"
                GPU_LABEL="Intel (vaapi unavailable) → auto hwdec + vulkan api"
            fi
        fi
    else
        GPU_LABEL="unrecognised GPU → safe auto defaults"
    fi
else
    GPU_LABEL="lspci not found → safe auto defaults"
fi

# ── Debug output (only when MPV_DEBUG=1) ─────────────────────────────────────
if [[ "${MPV_DEBUG:-0}" == "1" ]]; then
    echo "[mpv-launch] GPU detected : $GPU_INFO" >&2
    echo "[mpv-launch] Profile      : $GPU_LABEL" >&2
    echo "[mpv-launch] hwdec        : $HWDEC" >&2
    echo "[mpv-launch] gpu-api      : $GPU_API" >&2
    echo "[mpv-launch] vo           : $VO" >&2
fi

# ── Argument sanitisation (strip trailing empty args) ─────────────────────────
args=("$@")
while [[ ${#args[@]} -gt 0 && -z "${args[-1]}" ]]; do
    unset 'args[-1]'
done

# ── No file given → show version ──────────────────────────────────────────────
if [[ ${#args[@]} -eq 0 ]]; then
    exec mpv --version
fi

# ── Launch ────────────────────────────────────────────────────────────────────
exec mpv \
    --hwdec="$HWDEC" \
    --vo="$VO" \
    --gpu-api="$GPU_API" \
    "${args[@]}"

: 1780401896:0;# Install uv\
sudo pacman -S uv\
\
# Nuke the broken venv\
rm -rf venv\
\
# Create a new venv forced to Python 3.12 (uv downloads the toolchain automatically)\
uv venv --python 3.12 venv\
source venv/bin/activate\
\
# Install the packages cleanly and significantly faster\
uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu\
uv pip install -r requirements.txt

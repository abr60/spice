: 1780367839:0;# See what's running right now at system level\
systemctl list-units --type=service --state=running\
\
# See what user services are enabled\
systemctl --user list-unit-files --state=enabled\
\
# Check if pipewire/wireplumber are running (audio)\
systemctl --user status pipewire wireplumber\
\
# Check if your polkit agent is running (needed for GUI apps needing auth)\
systemctl --user list-units | grep -i polkit\
\
# See what's failed\
systemctl --failed\
systemctl --user --failed\
\
# Check if bluetooth has an agent (some setups need blueman-applet or similar)\
systemctl --user status bluetooth-applet 2>/dev/null || echo "no user bluetooth agent"\
\
# Touchegg (you enabled it) ‚ÄÉ¥ check if it's still there\
systemctl status touchegg\
\
# Waydroid (disabled) ‚ÄÉ¥ just in case you want it\
systemctl status waydroid-container

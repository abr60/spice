: 1780404129:0;# 1. Nuke the 3.12 environment\
rm -rf venv\
\
# 2. Spin up a Python 3.11 environment to satisfy the repo's strict <3.12 constraint\
uv venv --python 3.11 venv\
\
# 3. Install torch into the environment\
uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu\
\
# 4. Install requirements while ignoring the malformed ZIP headers in that specific wheel\
UV_INSECURE_NO_ZIP_VALIDATION=1 uv pip install -r requirements.txt

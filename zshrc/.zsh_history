\
# Package count breakdown\
pacman -Qdt | wc -l   # orphaned packages\
\
# Explicit vs dependency installs\
pacman -Qe | wc -l\
pacman -Qd | wc -l\
\
# Biggest packages\
pacman -Qi | awk '/^Name/{name=$3} /^Installed Size/{print $4$5, name}' | sort -h | tail -20

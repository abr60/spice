: 1780301302:0;sudo bash -c '\
for f in /var/lib/iwd/*.psk; do\
  name=$(basename "$f" .psk)\
  if [[ "$name" =~ ^=([0-9a-fA-F]+)$ ]]; then\
    decoded=$(echo "${BASH_REMATCH[1]}" | xxd -r -p 2>/dev/null || echo "Hex-Encoded Network")\
    echo "File: $name  -->  Decoded Wi-Fi Name: $decoded"\
  else\
    echo "File: $name  -->  Decoded Wi-Fi Name: $name"\
  fi\
done\
'\

: 1780301337:0;sudo bash -c '\
for f in /var/lib/iwd/*.psk; do\
  name=$(basename "$f" .psk)\
  if [[ "$name" =~ ^=([0-9a-fA-F]+)$ ]]; then\
    hex="${BASH_REMATCH[1]}"\
    # Convert hex string into standard escape formatting\
    escaped=$(echo "$hex" | sed "s/\(..\)/\\\\x\1/g")\
    decoded=$(printf "$escaped")\
    echo "File: $name  -->  Decoded Wi-Fi Name: $decoded"\
  else\
    echo "File: $name  -->  Decoded Wi-Fi Name: $name"\
  fi\
done\
'\


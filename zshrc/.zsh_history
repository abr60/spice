: 1780380274:0;cat > ~/.local/bin/comic-translate << 'EOF'\
#!/usr/bin/env bash\
\
TMPIMG="/tmp/comic_ocr_$$.png"\
\
# Capture region\
grim -g "$(slurp)" "$TMPIMG" || exit 1\
\
# Auto-detect language from tesseract, then translate\
RAW=$(tesseract "$TMPIMG" stdout -l jpn+kor+chi_sim+spa+eng 2>/dev/null)\
\
if [ -z "$RAW" ] || [ ${#RAW} -lt 2 ]; then\
    notify-send "Comic Translate" "‚ÉΩÉ¨ No text detected" -t 3000\
    rm -f "$TMPIMG"\
    exit 1\
fi\
\
# Translate to English\
TRANSLATED=$(echo "$RAW" | trans -b -q :en 2>/dev/null)\
\
notify-send "ÉøÉ≥É∂ Comic Translate" "$TRANSLATED" -t 8000\
echo "$TRANSLATED" | wl-copy\
\
rm -f "$TMPIMG"\
EOF\
\
chmod +x ~/.local/bin/comic-translate

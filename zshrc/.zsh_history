: 1780134359:0;# 1. Version & binary\
matugen --version\
which matugen\
ls -la $(which matugen)\
\
# 2. How it was installed\
pacman -Qi matugen 2>/dev/null       # via official/AUR pacman\
yay -Qi matugen 2>/dev/null          # via yay\
paru -Qi matugen 2>/dev/null         # via paru\
cargo install --list | grep matugen  # via cargo\
\
# 3. Runtime dependencies\
ldd $(which matugen)\
\
# 4. Config structure\
find ~/.config/matugen -maxdepth 3\
cat ~/.config/matugen/config.toml 2>/dev/null\
\
# 5. Templates\
ls -la ~/.config/matugen/templates/ 2>/dev/null\
\
# 6. What scripts call matugen (your theming pipeline)\
grep -r "matugen" ~/.config/hypr/ --include="*.sh" --include="*.conf" -l\
grep -r "matugen" ~/.config/waybar/ --include="*.sh" -l 2>/dev/null
: 1780135798:0;#!/usr/bin/env bash\
# switch_walls path audit\
\
THEME_NAME=$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || echo "default")\
\
check() {\
    local label="$1" path="$2" type="$3"\
    printf "%-45s" "$label"\
    if [[ "$type" == "d" ]]; then\
        [[ -d "$path" ]] && echo "‚ÉºÉ≥  DIR   $path" || echo "‚ÉºÉ∑  MISS  $path"\
    elif [[ "$type" == "f" ]]; then\
        [[ -f "$path" ]] && echo "‚ÉºÉ≥  FILE  $path" || echo "‚ÉºÉ∑  MISS  $path"\
    elif [[ "$type" == "l" ]]; then\
        if [[ -L "$path" ]]; then\
            target=$(readlink -f "$path")\
            [[ -e "$target" ]] && echo "‚ÉºÉ≥  LINK  $path ‚É¶É≤ $target" \\
                               || echo "‚É∫ÉÄ  DLINK $path ‚É¶É≤ $target (dangling)"\
        else\
            echo "‚ÉºÉ∑  MISS  $path"\
        fi\
    elif [[ "$type" == "x" ]]; then\
        command -v "$path" >/dev/null 2>&1 \\
            && echo "‚ÉºÉ≥  BIN   $(command -v $path)" \\
            || echo "‚ÉºÉ∑  MISS  $path (not in PATH)"\
    fi\
}\
\
echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
echo " switch_walls ‚ÄÉ¥ path & dependency audit"\
echo " theme: $THEME_NAME"\
echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
\
echo -e "\n‚É¥Ä‚É¥Ä INPUTS (wallpaper sources) ‚É¥Ä‚É¥Ä"\
check "user bg dir"        "$HOME/.config/omarchy/backgrounds/$THEME_NAME"           d\
check "theme bg dir"       "$HOME/.config/omarchy/current/theme/backgrounds"         d\
check "current bg symlink" "$HOME/.config/omarchy/current/background"                l\
check "theme name file"    "$HOME/.config/omarchy/current/theme.name"                f\
check "walker.css"         "$HOME/.config/omarchy/current/theme/walker.css"          f\
check "rofi theme"         "$HOME/.config/rofi/wallpaper.rasi"                       f\
\
echo -e "\n‚É¥Ä‚É¥Ä OUTPUTS (generated/written) ‚É¥Ä‚É¥Ä"\
check "hypr bin dir"       "$HOME/.config/hypr/bin"                                  d\
check "matugen-hyprlock"   "$HOME/.config/hypr/bin/matugen-hyprlock.conf"            f\
check "waybar matugen.css" "$HOME/.config/waybar/matugen.css"                        f\
check "matugen cache dir"  "$HOME/.cache/matugen"                                    d\
check "colors.json"        "$HOME/.cache/matugen/colors.json"                        f\
check "thumb cache dir"    "$HOME/.cache/wallpaper-thumbs/$THEME_NAME"               d\
\
echo -e "\n‚É¥Ä‚É¥Ä MATUGEN TEMPLATES (inputs) ‚É¥Ä‚É¥Ä"\
check "waybar.css"         "$HOME/.config/matugen/templates/waybar.css"              f\
check "hyprland.conf"      "$HOME/.config/matugen/templates/hyprland.conf"           f\
check "hyprlock.conf"      "$HOME/.config/matugen/templates/hyprlock.conf"           f\
check "swaync.css"         "$HOME/.config/matugen/templates/swaync.css"              f\
check "rofi.rasi"          "$HOME/.config/matugen/templates/rofi.rasi"               f\
check "cava.ini"           "$HOME/.config/matugen/templates/cava.ini"                f\
check "rmpc.ron"           "$HOME/.config/matugen/templates/rmpc.ron"                f\
check "spicetify.ini"      "$HOME/.config/matugen/templates/spicetify.ini"           f\
\
echo -e "\n‚É¥Ä‚É¥Ä MATUGEN TEMPLATE OUTPUTS ‚É¥Ä‚É¥Ä"\
check "waybar matugen.css" "$HOME/.config/waybar/matugen.css"                        f\
check "hyprland.conf out"  "$HOME/.config/hypr/bin/hyprland.conf"                    f\
check "hyprlock.conf out"  "$HOME/.config/hypr/hyprlock.conf"                        f\
check "swaync matugen.css" "$HOME/.config/swaync/CSS/matugen.css"                    f\
check "rofi.rasi out"      "$HOME/.cache/matugen/rofi.rasi"                          f\
check "cava theme out"     "$HOME/.config/cava/themes/matugen-theme"                 f\
check "rmpc theme out"     "$HOME/.config/rmpc/themes/matugen.ron"                   f\
check "spicetify color.ini""$HOME/.config/spicetify/Themes/Comfy/color.ini"          f\
\
echo -e "\n‚É¥Ä‚É¥Ä BINARIES / COMMANDS ‚É¥Ä‚É¥Ä"\
check "matugen"            matugen    x\
check "awww"               awww       x\
check "awww-daemon"        awww-daemon x\
check "uwsm-app"           uwsm-app   x\
check "rofi"               rofi       x\
check "ffmpeg"             ffmpeg     x\
check "hyprctl"            hyprctl    x\
check "inotifywait"        inotifywait x\
check "magick (IM7)"       magick     x\
check "convert (IM6)"      convert    x\
check "swaync-client"      swaync-client x\
check "spicetify"          spicetify  x\
check "pkill"              pkill      x\
check "notify-send"        notify-send x\
\
echo -e "\n‚É¥Ä‚É¥Ä WALLPAPER COUNT ‚É¥Ä‚É¥Ä"\
user_count=$(find -L "$HOME/.config/omarchy/backgrounds/$THEME_NAME" \\
    -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \\
    -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" \) 2>/dev/null | wc -l)\
theme_count=$(find -L "$HOME/.config/omarchy/current/theme/backgrounds" \\
    -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \\
    -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" \) 2>/dev/null | wc -l)\
thumb_count=$(find "$HOME/.cache/wallpaper-thumbs/$THEME_NAME" \\
    -maxdepth 1 -name "*.sqre.png" 2>/dev/null | wc -l)\
echo "  user wallpapers:   $user_count"\
echo "  theme wallpapers:  $theme_count"\
echo "  cached thumbnails: $thumb_count"\
\
echo -e "\n‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"
: 1780135988:0;# dry run first ‚ÄÉ¥ see what would be removed\
for thumb in ~/.cache/wallpaper-thumbs/q-florilegium/*.sqre.png; do\
    base="${thumb%.sqre.png}"\
    base=$(basename "$base")\
    if [[ -z "${base}" ]]; then continue; fi\
    # check if source exists in either dir\
    found=$(find -L ~/.config/omarchy/backgrounds/q-florilegium \\
                    ~/.config/omarchy/current/theme/backgrounds \\
                    -maxdepth 1 -name "$base" 2>/dev/null | head -1)\
    [[ -z "$found" ]] && echo "orphan: $thumb"\
done

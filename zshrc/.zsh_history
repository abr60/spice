\
# VKD3D\
ls ~/.local/share/lutris/runtime/vkd3d/ 2>/dev/null || echo "no lutris vkd3d"\
\
# Vulkan support\
vulkaninfo --summary 2>/dev/null | grep -E "deviceName|driverVersion" || echo "vulkaninfo missing"\
\
# 32-bit libs\
ldconfig -p | grep -E "libvulkan|libGL" | head -10\
\
# Wine deps\
pacman -Q wine-gecko wine-mono 2>/dev/null || echo "no wine-gecko/mono"\
\
# gamemode\
gamemoded -v 2>/dev/null || echo "gamemode not found"\
\
# df\
df -h
